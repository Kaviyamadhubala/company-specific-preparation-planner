# Environment Variables for Company-Specific Preparation Planner

# Database
DATABASE_URL=sqlite:///./prep_planner.db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI (optional - app works without it using fallback mode)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# App Settings
APP_NAME=Prep Planner
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
